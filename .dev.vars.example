# 本地完整开发（npm run cf:dev）的环境变量模板。
# 用法：复制为 .dev.vars 并填写真实值。.dev.vars 已在 .gitignore 中，不会提交。
# 生产环境的敏感值用 `npx wrangler secret put <变量名>` 设置，不要写进 wrangler.jsonc。

# 会话签名密钥（必填）：本地可随意填一段长字符串；生产环境建议用 openssl rand -base64 32 生成
SESSION_SECRET="dev-session-secret-please-change-me"

# 你的 GitHub 数字用户 ID（所有者校验，必填）
OWNER_GITHUB_ID=""

# 本地调试可选：请求头带 x-life-git-owner: <此值> 即视为管理员，免去 OAuth 登录
DEV_OWNER_TOKEN="local-dev-owner-token"

# GitHub OAuth App（管理员浏览器登录，可选）
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GitHub App（私有仓库读取与同步，可选）
# GITHUB_APP_PRIVATE_KEY 填 PEM 全文，多行用 \n 连接
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
GITHUB_APP_PRIVATE_KEY=""

# GitHub Webhook 签名密钥（仓库 push 后自动同步，可选）
GITHUB_WEBHOOK_SECRET=""

# OpenAI（AI 生成自我介绍，可选）
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6"
